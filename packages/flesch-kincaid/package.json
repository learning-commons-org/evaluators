{
  "name": "@learning-commons/flesch-kincaid",
  "version": "0.1.0",
  "description": "Flesch-Kincaid Grade Level that matches Python textstat exactly, for cross-language evaluator parity",
  "keywords": [
    "flesch-kincaid",
    "readability",
    "textstat",
    "syllables",
    "cmudict"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:data": "python3 scripts/generate-data.py"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "author": "Learning Commons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learning-commons-org/evaluators.git",
    "directory": "packages/flesch-kincaid"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  }
}
