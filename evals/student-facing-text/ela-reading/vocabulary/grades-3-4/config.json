{
  "$schema": "../../../../_schemas/config.schema.json",
  "evaluator": {
    "id": "student_facing_text.ela_reading.vocabulary_grades_3_4",
    "stable_id": "8be81547-9b4b-478b-b400-8cf8800fdcff",
    "id_history": ["literacy.ela_reading.vocabulary_grades_3_4"],
    "name": "Vocabulary Evaluator (Grades 3-4)",
    "description": "Evaluates the complexity of a text's vocabulary relative to grades 3-4, using a rubric-based prompt validated specifically for this grade band. Grades 5-12 use a different prompt, model and config: evals/student-facing-text/ela-reading/vocabulary/other-grades/.",
    "supported_grades": ["3", "4"]
  },
  "input_schema": {
    "$ref": "input_schema.json"
  },
  "preprocessing": [
    {
      "id": "fk_score",
      "type": "computation",
      "kind": "flesch_kincaid_grade",
      "description": "Compute the Flesch-Kincaid Grade Level for the input text and bind it to {fk_score} in the prompt.",
      "input": "text",
      "output": "fk_score",
      "implementation": {
        "python": {
          "library": "textstat",
          "function": "flesch_kincaid_grade",
          "post_transform": { "type": "round", "precision": 2 }
        },
        "typescript": {
          "library": "text-readability",
          "function": "fleschKincaidGrade",
          "post_transform": { "type": "round", "precision": 2 }
        }
      }
    }
  ],
  "steps": [
    {
      "id": "background_knowledge",
      "type": "llm",
      "description": "Generates a short assumption about what students at the target grade already know about the text's topic. Runs before vocab_complexity and feeds it {student_background_knowledge}. This prompt is shared with the other-grades path: ../background-knowledge.txt.",
      "prompt": {
        "messages": [
          {
            "role": "user",
            "source_path": "../background-knowledge.txt",
            "sha256": "0128ab093be45401655231a1a9f27a4b1dc1142d2422a71976da3eee65ee8a18"
          }
        ],
        "placeholders": {
          "text": {
            "required": true,
            "source": "input"
          },
          "grade_level": {
            "required": true,
            "source": "input"
          }
        }
      },
      "model": {
        "provider": "openai",
        "name": "gpt-4o-2024-11-20"
      },
      "generation": {
        "temperature": 0
      },
      "parser": {
        "kind": "structured_output"
      }
    },
    {
      "id": "vocab_complexity",
      "type": "llm",
      "description": "NOTE: scripts/check.py's eval-config check currently only validates steps[0]'s prompt files (sha256 + placeholder sync) -- see scripts/checks/eval_config.py:_prompt(), which reads (config['steps'] or [{}])[0]. This step's system.txt/user.txt are NOT covered by that check today. Flagged, not fixed here, to stay scoped to this evaluator's own files.",
      "prompt": {
        "messages": [
          {
            "role": "system",
            "source_path": "system.txt",
            "sha256": "eb875340fca957bfcbbd2d088ce9362cf87771b6f97297df40741fb329f6d8c0"
          },
          {
            "role": "user",
            "source_path": "user.txt",
            "sha256": "b930b7ea238719a7fbd57dfabefd355724528445bbeb244f39c8418c3c2a301b"
          }
        ],
        "placeholders": {
          "text": {
            "required": true,
            "source": "input"
          },
          "grade_level": {
            "required": true,
            "source": "input.grade_level"
          },
          "student_background_knowledge": {
            "required": true,
            "source": "steps.background_knowledge.output"
          },
          "fk_score": {
            "required": true,
            "source": "preprocessing.fk_score"
          }
        }
      },
      "model": {
        "provider": "google",
        "name": "gemini-2.5-pro"
      },
      "generation": {
        "temperature": 0
      },
      "parser": {
        "kind": "structured_output"
      }
    }
  ],
  "output_schema": {
    "$ref": "output_schema.json"
  },
  "fixtures": {
    "path": "fixtures.json"
  }
}
