          },
          {
            "role": "user",
            "source_path": "analysis-user.txt",
            "sha256": "b09d7a2bf36c33c70afde69d5b91f059348def8e0060e7bc2429d9daf60c282c"
          }
        ],
        "placeholders": {
          "text": {
            "required": true,
