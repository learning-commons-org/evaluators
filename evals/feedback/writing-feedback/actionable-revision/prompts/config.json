{
  "spec_version": "1.0",
  "evaluator": {
    "id": "is_actionable_revision",
    "version": "0.1",
    "name": "Actionable Revision Feedback-Quality Evaluator",
    "description": "If revision is needed, does the feedback give a clear next step?",
    "dimension": "is_actionable_revision",
    "output_type": "binary",
    "labels": [
      0,
      1
    ],
    "optimization": {
      "method": "GEPA",
      "framework": "DSPy",
      "base_model": "gpt-5.4",
      "prompt_source": "outputs/gepa_prompt_gpt_5_4.txt",
      "source_notebook": "build_evaluator.ipynb",
      "optimized_at": "2026-06-18"
    },
    "owners": [
      "ariena.chi@chanzuckerberg.com"
    ]
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
