{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input_schema.json",
  "title": "EvaluatorInput",
  "type": "object",
  "required": ["text", "grade_level"],
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "The passage to evaluate."
    },
    "grade_level": {
      "type": "integer",
      "minimum": 3,
      "maximum": 12,
      "description": "Target student grade level."
    }
  }
}
