# Enter your AI API keys here.
# OPENAI_API_KEY="..."
# GOOGLE_API_KEY="..."

# LiteLLM proxy — single key for all providers (GPT, Gemini, Claude) via a LiteLLM-compatible proxy.
# When set, notebooks use the proxy instead of calling provider APIs directly.
# LITELLM_API_KEY="..."
# LITELLM_BASE_URL="https://llm.labxchange-dev.org"
